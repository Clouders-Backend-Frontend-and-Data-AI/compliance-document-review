# Server Configuration
PROJECT_NAME="Compliance Document Review API"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-key-for-jwt-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default for seamless clean checkout; can use postgresql://user:pass@localhost:5432/compliance)
DATABASE_URL="sqlite:///./compliance_app.db"

# Storage Configuration
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10

# AI / LLM Configuration (Gemini API via Google AI Studio recommended, or leave blank for offline graceful fallback)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
AI_TIMEOUT_SECONDS=30

# Vector Retrieval Thresholds
DISCLOSURE_ABSENCE_THRESHOLD=0.60
PRECEDENT_TOP_K=3
RULE_RETRIEVAL_TOP_K=5
