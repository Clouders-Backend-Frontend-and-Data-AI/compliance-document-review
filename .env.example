# ============================================================
# Compliance Document Review - Environment Configuration
# ============================================================

PROJECT_NAME="Compliance Document Review API"
API_V1_STR="/api/v1"
ENVIRONMENT=development

# Security — use a long random SECRET_KEY (>=32 chars) in any shared/prod deploy
SECRET_KEY="replace-with-a-long-random-string-at-least-32"
ALLOW_INSECURE_DEFAULTS=true
ALLOW_OFFICER_SIGNUP=true
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database — SQLite for clean checkout; postgresql://... for pgvector
DATABASE_URL="sqlite:///./compliance_app.db"
USE_DATA_ENGINEERING=true

UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10
ALLOW_PLAINTEXT_UPLOADS=false

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
AI_TIMEOUT_SECONDS=30
EMBEDDING_DIMENSION=768

DISCLOSURE_ABSENCE_THRESHOLD=0.60
PRECEDENT_TOP_K=3
RULE_RETRIEVAL_TOP_K=5

BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"
ALLOWED_HOSTS="localhost,127.0.0.1,testserver"

ENABLE_RATE_LIMITING=true
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=30
ENABLE_API_DOCS=true

# Docker / Postgres
POSTGRES_DB=compliance_db
POSTGRES_USER=compliance_user
POSTGRES_PASSWORD=change-me-db-password
