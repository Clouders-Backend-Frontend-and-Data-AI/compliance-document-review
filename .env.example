# Server Configuration
PROJECT_NAME="Compliance Document Review API"
API_V1_STR="/api/v1"
# REQUIRED in production — do not use the placeholder below
SECRET_KEY="replace-with-a-long-random-string"
ALLOW_INSECURE_DEFAULTS=true
ENVIRONMENT=development
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database — SQLite for clean checkout; use postgresql+psycopg2://... for pgvector
DATABASE_URL="sqlite:///./compliance_app.db"
# When true AND DATABASE_URL is Postgres, use data_engineering ingest/retrieval
USE_DATA_ENGINEERING=true

# Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10
ALLOW_PLAINTEXT_UPLOADS=false

# AI / LLM (leave blank for offline graceful fallback)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
AI_TIMEOUT_SECONDS=30
EMBEDDING_DIMENSION=768

# Vector Retrieval Thresholds
DISCLOSURE_ABSENCE_THRESHOLD=0.60
PRECEDENT_TOP_K=3
RULE_RETRIEVAL_TOP_K=5

# CORS — comma-separated origins (avoid * with credentials)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# Docker / Postgres (used by docker-compose.yml)
POSTGRES_DB=compliance_db
POSTGRES_USER=compliance_user
POSTGRES_PASSWORD=change-me-db-password
